local SLIDER_MIN = 16
local SLIDER_MAX = 1000   -- <<< теперь максимум 1000
local sliding = false

local function sliderToValue(x)
    local alpha = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
    return math.floor(SLIDER_MIN + alpha * (SLIDER_MAX - SLIDER_MIN) + 0.5)
end

local function updateSliderVisual(v)
    local alpha = (v - SLIDER_MIN) / (SLIDER_MAX - SLIDER_MIN)
    fill.Size = UDim2.new(alpha, 0, 1, 0)
    thumb.Position = UDim2.new(alpha, -8, 0.5, -8)
    speedValueLabel.Text = tostring(v)
end

track.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        sliding = true
        local v = sliderToValue(input.Position.X)
        state.speed = v
        updateSliderVisual(v)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        local v = sliderToValue(input.Position.X)
        state.speed = v
        updateSliderVisual(v)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        sliding = false
    end
end)

--// кнопки-переключатели
local function makeToggle(posY, labelText, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 290, 0, 32)
    btn.Position = UDim2.new(0, 20, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    btn.TextColor3 = Color3.fromRGB(230, 230, 230)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.Parent = main

    local bCorner = Instance.new("UICorner")
    bCorner.CornerRadius = UDim.new(0, 8)
    bCorner.Parent = btn

    local on = false
    local function refresh()
        if on then
            btn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
            btn.Text = labelText .. ": ВКЛ"
        else
            btn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
            btn.Text = labelText .. ": ВЫКЛ"
        end
    end

    btn.MouseButton1Click:Connect(function()
        on = not on
        refresh()
        callback(on)
    end)

    refresh()
end

makeToggle(104, "СКОРОСТЬ", function(on)
    state.speedOn = on
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum and not on then
        hum.WalkSpeed = DEFAULT_SPEED
    end
end)

makeToggle(146, "NOCLIP", function(on)
    state.noclip = on
    if not on then
        local char = player.Character
        if char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") and p.Name ~= "Handle" then
                    p.CanCollide = false
                    p.CanCollide = true
                end
            end
        end
    end
end)

